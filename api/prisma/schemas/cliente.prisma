
enum Documento {
    CPF
    CNPJ
}

model Cliente {
    id        Int       @id @default(autoincrement())
    documento Documento @unique @default(CPF) //CPF ou CNPJ
    numero    String
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    pessoa    Pessoa    @relation(fields: [pessoaId], references: [id])
    pessoaId  Int       @unique

    pedidos Pedido[]
}
