model Endereco {
    id              Int     @id @default(autoincrement())
    CEP             String 
    rua             String
    numero          String?
    pontoReferencia String?
    complemento     String?
    cidade          String
    uf              String
    pessoas     EnderecoPessoa[] 

    createdAt DateTime @default(now())
    updatedAt   DateTime @updatedAt
}
