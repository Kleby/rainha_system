model Endereco {
    id              Int     @id @default(autoincrement())
    cep             String @unique 
    rua             String
    numero          String @default("S/N")
    pontoReferencia String @default("-")
    complemento     String @default("-")
    cidade          String 
    uf              String
    pessoas     EnderecoPessoa[] 

    createdAt DateTime @default(now())
    updatedAt   DateTime @updatedAt
}
