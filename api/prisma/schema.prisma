// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
    provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Cargo{
	ADMIN
	GERENTE
	OPERADOR
}

model Usuario{
	id			String		@id	@default(uuid())
	nome		String
	Usuario		String		@unique
	email		String		@unique
	senhaHash	String	
	vendas		Pedido[]
	cargo		Cargo		@default(OPERADOR)
	createdAt	DateTime	@default(now())
	updatedAt	DateTime	@default(now())
	logs		Log[]
}

enum CampoModificado {
	NENHUM
	PEDIDO
	PRODUTO
	CLIENTE
	USUARIO
	ESTOQUE
}

model Log{
	id			String		@id @default(uuid())
	campo		CampoModificado	@default(NENHUM)
	idCampo		String		@unique
	usuario		Usuario		@relation(fields: [usuarioId], references: [id])
	usuarioId	String
	createdAt	DateTime	@default(now())
	updatedAt	DateTime	@default(now())
	clientes 	Cliente[]
	estoques 	Estoque[]
	Promocoes	Promocao[]
	produtos 	Produto[]
	pedidos 	Pedido[]
	itensPedidos	ItemPedido[]
}

model Cliente{
	id			String		@id	@default(uuid())
	nome		String	
	documento	String		@unique		//CPF ou CNPJ
	email		String?
	pedidos		Pedido[]
	createdAt	DateTime	@default(now())
	updatedAt	DateTime	@default(now())
	log			Log			@relation(fields: [logId], references: [id])
	logId		String
}

model Estoque{
	id			String		@id @default(uuid())
	nome		String		@unique
	produto		Produto[]
	quantidade	Int			@default(0)
	log			Log			@relation(fields: [logId], references: [id])
	logId		String
}

model Promocao{
	id			String		@id @default(uuid())
	status		Boolean		@default(false)
	produtosPromocionais	ProdutoPromocao[]
	inicioPromocao	DateTime	@default(now())
	fimPromocao		DateTime	@default(now())
	createdAt		DateTime	@default(now())
	updatedAt		DateTime	@default(now())
	log				Log			@relation(fields: [logId], references: [id])
	logId			String
}

model ProdutoPromocao{
	id			String		@id @default(uuid())		
	produto 	Produto		@relation(fields: [produtoId], references: [id])
	produtoId	String
	precoPromocional	Decimal	@db.Decimal(10,2)
	quantidadeMinima	Int		@default(1)
	promocao 			Promocao	@relation(fields: [promocaoId], references: [id])
	promocaoId String
}


model Produto{
	id			String		@id	@default(uuid())
	nome		String	
	sku			String		@unique
	preco		Decimal		@db.Decimal(10, 2)
	custoReal			Decimal		@db.Decimal(10,2)
	custoOperacional	Decimal		@db.Decimal(10,2)
	custoUnitario		Decimal		@db.Decimal(10,2)
	emPromocao			Boolean		@default(false)
	estoque 	Estoque		@relation(fields: [estoqueId], references: [id])
	estoqueId	String
	itensPedido ItemPedido[]
	createdAt	DateTime	@default(now())
	updatedAt	DateTime	@default(now())
	log			Log			@relation(fields: [logId], references: [id])
	logId		String	
	produtosPromocoes ProdutoPromocao[]
}

enum StatusPedido{
	ABERTO
	FECHADO
	FATURADO
	CANCELADO	
}

model Pedido{
	id			String		@id	@default(uuid())
	cliente		Cliente		@relation(fields: [clienteId], references: [id])
	clienteId	String		
	status		StatusPedido	@default(ABERTO)
	itens		ItemPedido[]
	createdAt	DateTime	@default(now())
	updatedAt	DateTime	@default(now())
	usuario		Usuario		@relation(fields: [usuarioId], references:[id])	
	usuarioId	String
	log			Log			@relation(fields: [logId], references: [id])
	logId		String
}

model ItemPedido{
	id			String		@id	@default(uuid())
	pedido		Pedido		@relation(fields: [pedidoId], references: [id])
	pedidoId	String
	produto		Produto		@relation(fields: [produtoId], references: [id])
	produtoId	String
	Log			Log			@relation(fields: [logId], references: [id])
	logId		String
}

